# Copie para .env: cp .env.example .env

# Banco local (docker compose). Credenciais de desenvolvimento, não são segredos.
DATABASE_URL="postgresql://acutis:acutis@localhost:5432/acutis_dev"
DATABASE_URL_TEST="postgresql://acutis:acutis@localhost:5432/acutis_test"

# Segredo de autenticação (mínimo 32 caracteres). Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="TROQUE-ME"
BETTER_AUTH_URL="http://localhost:3000"

# Conta inicial da coordenação (usada apenas pelo seed)
SEED_COORDENACAO_EMAIL="coordenacao@exemplo.com"
SEED_COORDENACAO_SENHA="troque-esta-senha"
SEED_COORDENACAO_NOME="Coordenação"

# Rate limit do Better Auth: on | off
AUTH_RATE_LIMIT="on"
